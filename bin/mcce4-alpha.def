Bootstrap: docker
From: condaforge/miniforge3

# NOTE: This container is for Linux HPC distribution.
# macOS users use Lima VM with native build instead (no container needed).
# Apptainer pulls the correct arch (x86_64 or aarch64) automatically.

%labels
    Author      "Julian A. Rendon"
    Maintainer  "Gunner Lab"
    Description "MCCE4-Alpha Apptainer Environment"
    Source      "https://github.com/GunnerLab/MCCE4-Alpha"

%files
    ./ /opt/MCCE4-Alpha

%post
    set -e

    # ── System packages ─────────────────────────────────────────────────────
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential file \
        curl git wget ca-certificates \
        vim tree

    apt-get clean && rm -rf /var/lib/apt/lists/*

    # ── Conda environment ─────────────────────────────────────────────────────
    . /opt/conda/etc/profile.d/conda.sh

    if [ ! -f /opt/MCCE4-Alpha/mc4.yml ]; then
        echo "ERROR: /opt/MCCE4-Alpha/mc4.yml not found."
        exit 1
    fi

    conda env create -f /opt/MCCE4-Alpha/mc4.yml -n mc4
    conda clean --all -y

    # ── Build MCCE4 ──────────────────────────────────────────────────────────
    export PATH="/opt/conda/envs/mc4/bin:$PATH"
    export CONDA_PREFIX="/opt/conda/envs/mc4"
    export CONDA_DEFAULT_ENV="mc4"

    cd /opt/MCCE4-Alpha

    # Clean ONLY make-produced targets. Do NOT touch precompiled binaries
    # (apbs, delphi_precompiled, etc.) that ship with the repo.
    if [ -f Makefile ]; then
        make clean 2>/dev/null || true
    fi
    rm -f bin/mcce bin/delphi 2>/dev/null || true
    rm -f lib/*.o lib/*.a 2>/dev/null || true

    # Build from Makefile
    if [ -f Makefile ]; then
        echo "Building MCCE from Makefile..."
        echo "  CC  = $(which gcc)"
        echo "  C++ = $(which g++)"
        make
    else
        echo "WARNING: No Makefile found."
    fi

    # Verify mcce was built
    if [ ! -f bin/mcce ]; then
        echo "ERROR: bin/mcce was not produced by the build."
        echo "Contents of bin/:"
        ls -la bin/ | head -20
        echo "Contents of lib/:"
        ls -la lib/*.o lib/*.a 2>/dev/null || echo "  (no .o or .a files)"
        exit 1
    fi
    echo "✅ bin/mcce built: $(file bin/mcce)"

    # ── Ensure delphi is available ────────────────────────────────────────────
    # The Makefile builds bin/delphi from source, but the repo also ships
    # bin/delphi_precompiled as a fallback. Create a symlink if make didn't
    # produce bin/delphi.
    if [ ! -f bin/delphi ] && [ -f bin/delphi_precompiled ]; then
        echo "   Linking delphi_precompiled → delphi"
        ln -sf delphi_precompiled bin/delphi
    fi

    # ── Permissions ──────────────────────────────────────────────────────────
    chmod -R a+rX /opt/MCCE4-Alpha
    chmod -R a+rX /opt/conda/envs/mc4

%environment
    export MCCE4_ROOT="/opt/MCCE4-Alpha"
    export CONDA_PREFIX="/opt/conda/envs/mc4"
    export CONDA_DEFAULT_ENV="mc4"
    export PATH="${CONDA_PREFIX}/bin:${MCCE4_ROOT}/bin:${MCCE4_ROOT}/MCCE_bin:${PATH}"

    for _sp in "${CONDA_PREFIX}"/lib/python*/site-packages; do
        [ -d "$_sp" ] && export PYTHONPATH="${_sp}:${PYTHONPATH:-}" && break
    done

%runscript
    exec /bin/bash "$@"

%startscript
    exec tail -f /dev/null

%test
    export PATH="/opt/conda/envs/mc4/bin:/opt/MCCE4-Alpha/bin:/opt/MCCE4-Alpha/MCCE_bin:$PATH"

    echo "── Container smoke test ──"

    echo -n "  Python: "
    python3 --version || { echo "FAIL"; exit 1; }

    echo -n "  NumPy:  "
    python3 -c "import numpy; print(numpy.__version__)" || { echo "FAIL"; exit 1; }

    echo -n "  SciPy:  "
    python3 -c "import scipy; print(scipy.__version__)" || { echo "FAIL"; exit 1; }

    # Verify mcce binary format
    MCCE_BIN="/opt/MCCE4-Alpha/bin/mcce"
    if [ -f "$MCCE_BIN" ]; then
        echo -n "  mcce: "
        file_type=$(file "$MCCE_BIN")
        echo "$file_type"
        if echo "$file_type" | grep -q "Mach-O"; then
            echo "  FAIL: mcce is a macOS binary!"
            exit 1
        fi
    else
        echo "  FAIL: mcce not found"
        exit 1
    fi

    # Verify delphi
    if [ -f /opt/MCCE4-Alpha/bin/delphi ] || [ -f /opt/MCCE4-Alpha/bin/delphi_precompiled ]; then
        echo "  delphi: ✅"
    else
        echo "  delphi: ⚠️  not found"
    fi

    echo "── Smoke test passed ──"
