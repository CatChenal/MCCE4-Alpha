Bootstrap: docker
From: condaforge/miniforge3

# For Linux HPC distribution only.
# macOS users use Lima VM with native build (setup_mac.sh).

%labels
    Author      "Gehan A. Ranepura and Julian A. Rendon"
    Maintainer  "Gunner Lab"
    Description "MCCE4-Alpha Apptainer Environment"
    Source      "https://github.com/GunnerLab/MCCE4-Alpha"

%files
    ./ /opt/MCCE4-Alpha

%post
    set -e

    apt-get update && apt-get install -y --no-install-recommends \
        build-essential gfortran file \
        curl git wget ca-certificates \
        vim tree

    apt-get clean && rm -rf /var/lib/apt/lists/*

    # Conda environment
    . /opt/conda/etc/profile.d/conda.sh

    if [ ! -f /opt/MCCE4-Alpha/mc4.yml ]; then
        echo "ERROR: mc4.yml not found"; exit 1
    fi

    conda env create -f /opt/MCCE4-Alpha/mc4.yml -n mc4

    # Install apptainer inside the container (needed by step3.py for NGPB solver,
    # which launches NextGenPB_MCCE4.sif as a nested container)
    conda install -n mc4 -c conda-forge apptainer -y

    conda clean --all -y

    # Build MCCE4
    export PATH="/opt/conda/envs/mc4/bin:$PATH"
    export CONDA_PREFIX="/opt/conda/envs/mc4"

    cd /opt/MCCE4-Alpha

    # Clean ONLY make-produced targets — preserve precompiled binaries
    if [ -f Makefile ]; then
        make clean 2>/dev/null || true
    fi
    rm -f bin/mcce bin/delphi lib/*.o lib/*.a 2>/dev/null || true

    if [ -f Makefile ]; then
        echo "Building MCCE from Makefile..."
        make
    fi

    # Verify
    if [ ! -f bin/mcce ]; then
        echo "ERROR: bin/mcce not produced."
        ls -la bin/ | head -20
        exit 1
    fi
    echo "mcce built: $(file bin/mcce)"

    # Ensure delphi is available
    if [ ! -f bin/delphi ] && [ -f bin/delphi_precompiled ]; then
        ln -sf delphi_precompiled bin/delphi
        echo "Linked delphi_precompiled → delphi"
    fi

    # NextGenPB .sif files are NOT baked into the container 
    # (They are ~1.6GB and would cause mksquashfs to OOM on memory-limited servers).
    # Instead, mc4 bind-mounts them from the host at runtime.
    # Remove any that accidentally got copied in via %files.
    rm -f bin/NextGenPB.sif bin/NextGenPB_MCCE4.sif 2>/dev/null || true

    chmod -R a+rX /opt/MCCE4-Alpha
    chmod -R a+rX /opt/conda/envs/mc4

%environment
    export MCCE4_ROOT="/opt/MCCE4-Alpha"
    export CONDA_PREFIX="/opt/conda/envs/mc4"
    export CONDA_DEFAULT_ENV="mc4"
    export PATH="${CONDA_PREFIX}/bin:${MCCE4_ROOT}/bin:${MCCE4_ROOT}/MCCE_bin:${PATH}"

    for _sp in "${CONDA_PREFIX}"/lib/python*/site-packages; do
        [ -d "$_sp" ] && export PYTHONPATH="${_sp}:${PYTHONPATH:-}" && break
    done

%runscript
    exec /bin/bash "$@"

%startscript
    exec tail -f /dev/null

%test
    export PATH="/opt/conda/envs/mc4/bin:/opt/MCCE4-Alpha/bin:/opt/MCCE4-Alpha/MCCE_bin:$PATH"

    echo "── Smoke test ──"
    python3 --version || exit 1
    python3 -c "import numpy; print('NumPy', numpy.__version__)" || exit 1

    if [ -f /opt/MCCE4-Alpha/bin/mcce ]; then
        ft=$(file /opt/MCCE4-Alpha/bin/mcce)
        echo "mcce: $ft"
        echo "$ft" | grep -q "Mach-O" && { echo "FAIL: macOS binary!"; exit 1; }
    else
        echo "FAIL: mcce not found"; exit 1
    fi

    [ -f /opt/MCCE4-Alpha/bin/delphi ] || [ -f /opt/MCCE4-Alpha/bin/delphi_precompiled ] \
        && echo "delphi: OK" || echo "delphi: missing"

    command -v apptainer >/dev/null 2>&1 \
        && echo "apptainer: OK ($(apptainer --version))" || echo "apptainer: MISSING (NGPB will not work)"

    echo "NGPB image: bind-mounted at runtime by mc4 (not baked into container)"

    echo "── Passed ──"
