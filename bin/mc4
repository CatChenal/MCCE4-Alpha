#!/bin/bash
# mc4 — MCCE4-Alpha CLI
#
#   Linux + container  → apptainer exec mcce4-alpha.sif <command>
#   macOS + Lima       → limactl shell mcce4 -- <command>  (native Linux, no container)
#   Native fallback    → run <command> directly via conda env mc4

# ── Resolve paths portably ────────────────────────────────────────────────────
if command -v python3 >/dev/null 2>&1; then
    BIN_DIR=$(python3 -c "import os,sys; print(os.path.dirname(os.path.realpath(sys.argv[1])))" "$0")
elif command -v realpath >/dev/null 2>&1; then
    BIN_DIR=$(dirname "$(realpath "$0")")
else
    BIN_DIR=$(cd "$(dirname "$0")" && pwd)
fi

PROJECT_ROOT_DIR=$(dirname "$BIN_DIR")
CONTAINER_PATH="/opt/MCCE4-Alpha"
SIF_PATH="$BIN_DIR/mcce4-alpha.sif"
LIMA_INSTANCE="mcce4"

# ── Detect execution mode ─────────────────────────────────────────────────────
MODE="native"

if [[ "$(uname -s)" == "Linux" ]]; then
    if [[ -f "$SIF_PATH" ]] && command -v apptainer >/dev/null 2>&1; then
        MODE="linux-container"
    fi
elif [[ "$(uname -s)" == "Darwin" ]]; then
    if command -v limactl >/dev/null 2>&1 && limactl list 2>/dev/null | grep -q "$LIMA_INSTANCE"; then
        MODE="lima"
    fi
fi

# ── Help ──────────────────────────────────────────────────────────────────────
show_help() {
    echo "MCCE4-Alpha CLI Tool"
    echo ""
    echo "Usage: mc4 [OPTIONS] <COMMAND> [ARGS...]"
    echo ""
    echo "Options:"
    [[ "$MODE" == "linux-container" ]] && echo "  -d          Dev mode: bind local source into container"
    echo "  --shell     Open interactive Linux shell"
    echo "  -h, --help  Show this help"
    echo ""
    echo "Examples:"
    echo "  mc4 step1.py prot.pdb"
    echo "  mc4 step3.py"
    echo "  mc4 getpdb 4pti"
    echo "  mc4 --shell"
    echo ""
    case "$MODE" in
        linux-container) echo "Mode: Linux container ($SIF_PATH)" ;;
        lima)            echo "Mode: macOS → Lima VM (native Linux)" ;;
        native)          echo "Mode: Native (conda env mc4)" ;;
    esac
}

if [[ $# -eq 0 ]]; then
    echo "❌ No command provided."
    show_help
    exit 1
fi

[[ "$1" == "-h" || "$1" == "--help" ]] && { show_help; exit 0; }

# ── Ensure Lima VM is running ─────────────────────────────────────────────────
ensure_lima_running() {
    if limactl list 2>/dev/null | grep "$LIMA_INSTANCE" | grep -q "Running"; then
        return 0
    fi
    echo "⏳ Starting Lima VM '$LIMA_INSTANCE'..." >&2
    limactl start "$LIMA_INSTANCE" --tty=false >/dev/null 2>&1
    if ! limactl list 2>/dev/null | grep "$LIMA_INSTANCE" | grep -q "Running"; then
        echo "❌ Failed to start Lima VM. Run: bash setup_mac.sh" >&2
        exit 1
    fi
}

# ── Run command inside Lima with conda + MCCE4 PATH ──────────────────────────
lima_exec() {
    ensure_lima_running
    local cwd
    cwd=$(pwd)

    limactl shell "$LIMA_INSTANCE" -- bash -c "
        if [ -f \"\$HOME/miniforge3/etc/profile.d/conda.sh\" ]; then
            . \"\$HOME/miniforge3/etc/profile.d/conda.sh\"
        fi
        conda activate mc4 2>/dev/null
        export PATH=\"$BIN_DIR:$PROJECT_ROOT_DIR/MCCE_bin:\$PATH\"
        cd '$cwd'
        exec \"\$@\"
    " -- "$@"
}

# ── Interactive shell ─────────────────────────────────────────────────────────
if [[ "$1" == "--shell" ]]; then
    case "$MODE" in
        linux-container)
            exec apptainer shell "$SIF_PATH"
            ;;
        lima)
            ensure_lima_running
            echo "🐧 Entering Lima VM. Type 'exit' to return to macOS."
            echo "   Run: conda activate mc4"
            limactl shell "$LIMA_INSTANCE"
            ;;
        native)
            if command -v conda >/dev/null 2>&1; then
                eval "$(conda shell.bash hook)" 2>/dev/null
                conda activate mc4 2>/dev/null
            fi
            exec bash
            ;;
    esac
    exit 0
fi

# ── Dev mode ──────────────────────────────────────────────────────────────────
BIND_ARGS=""
if [[ "$1" == "-d" ]]; then
    shift
    [[ $# -eq 0 ]] && { echo "❌ No command after -d."; exit 1; }
    case "$MODE" in
        linux-container)
            echo "🔧 Dev mode: binding local code into container."
            BIND_ARGS="--bind $PROJECT_ROOT_DIR:$CONTAINER_PATH"
            ;;
        lima)  echo "ℹ️  -d not needed — Lima always uses your local code." ;;
        native) echo "ℹ️  -d not needed in native mode." ;;
    esac
fi

# ── Execute ────────────────────────────────────────────────────────────────────
case "$MODE" in
    linux-container)
        # Bind-mount NGPB .sif files from host into container
        # (they're kept on host to avoid bloating the container image)
        NGPB_BIND=""
        if [[ -f "$BIN_DIR/NextGenPB_MCCE4.sif" ]]; then
            NGPB_BIND="--bind $BIN_DIR/NextGenPB_MCCE4.sif:$CONTAINER_PATH/bin/NextGenPB_MCCE4.sif"
        fi
        if [[ -f "$BIN_DIR/NextGenPB.sif" ]]; then
            NGPB_BIND="$NGPB_BIND --bind $BIN_DIR/NextGenPB.sif:$CONTAINER_PATH/bin/NextGenPB.sif"
        fi
        exec apptainer exec $BIND_ARGS $NGPB_BIND "$SIF_PATH" "$@"
        ;;
    lima)
        lima_exec "$@"
        ;;
    native)
        export PATH="$BIN_DIR:$PROJECT_ROOT_DIR/MCCE_bin:$PATH"
        if [[ "${CONDA_DEFAULT_ENV:-}" != "mc4" ]]; then
            if command -v conda >/dev/null 2>&1; then
                eval "$(conda shell.bash hook)" 2>/dev/null
                conda activate mc4 2>/dev/null
            fi
        fi
        exec "$@"
        ;;
esac
