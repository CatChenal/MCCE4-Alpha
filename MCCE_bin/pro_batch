BAD_ANSWER = "Answer must be one of [yes, no, y, n] (case insensitive). Please try again."
DEFAULT_MAX_JOBS = 15
DEFAULT_NICE = 10
DEFAULT_SLURM_NICE = 1000


class JobPool:
    """Manages a pool of concurrent subprocess jobs with a concurrency limit (bash mode)."""

    def __init__(self, max_jobs: int = DEFAULT_MAX_JOBS, nice: int = DEFAULT_NICE,
                 poll_interval: float = 10.0):
        self.max_jobs = max_jobs
        self.nice = nice
        self.poll_interval = poll_interval
        self.running = {}   # {protein_name: subprocess.Popen}
        self.failed = []    # protein names that exited non-zero
        self.completed = [] # protein names that finished successfully

    def _poll(self):
        """Check running jobs, move finished ones to completed/failed."""
        finished = []
        for name, proc in self.running.items():
            retcode = proc.poll()
            if retcode is not None:
                finished.append(name)
                if retcode == 0:
                    self.completed.append(name)
                else:
                    self.failed.append(name)
                    print(f"  !! {name} exited with code {retcode} — check run.log")

        for name in finished:
            del self.running[name]

    def wait_for_slot(self):
        """Block until at least one job slot is available."""
        while len(self.running) >= self.max_jobs:
            self._poll()
            if len(self.running) >= self.max_jobs:
                time.sleep(self.poll_interval)

    def wait_for_all(self):
        """Block until every running job has finished."""
        while self.running:
            self._poll()
            if self.running:
                time.sleep(self.poll_interval)

    def launch(self, protein_name: str, p_dir: Path, script_name: str):
        """Launch a single protein run inside p_dir."""
        self.wait_for_slot()

        cmd = ["nice", "-n", str(self.nice), "bash", script_name]
        log_fp = p_dir / "run.log"
        log_fh = open(log_fp, "w")

        proc = subprocess.Popen(
            cmd,
            cwd=str(p_dir),
            stdout=log_fh,
            stderr=subprocess.STDOUT,
            preexec_fn=os.setpgrp,  # detach from terminal signals
        )
        proc._log_fh = log_fh
        self.running[protein_name] = proc
        print(f"  -> Started {protein_name} (PID {proc.pid}, "
              f"nice {self.nice}, {len(self.running)}/{self.max_jobs} slots)")

    def summary(self):
        """Print a final summary of completed/failed jobs."""
        total = len(self.completed) + len(self.failed)
        print(f"\n{'=' * 45}")
        print(f"Job Pool Summary: {total} jobs finished")
        print(f"  Completed : {len(self.completed)}")
        print(f"  Failed    : {len(self.failed)}")
        if self.failed:
            print(f"  Failed IDs: {', '.join(self.failed)}")
        print(f"{'=' * 45}")


class SlurmPool:
    """Manages Slurm job submissions with a concurrency limit by polling squeue."""

    SLURM_JOB_NAME = "mcce_batch"

    def __init__(self, max_jobs: int = DEFAULT_MAX_JOBS, nice: int = DEFAULT_SLURM_NICE,
                 poll_interval: float = 30.0):
        self.max_jobs = max_jobs
        self.nice = nice
        self.poll_interval = poll_interval
        self.submitted = []  # all protein names submitted

    def _count_running(self) -> int:
        """Count our active (running + pending) Slurm jobs by job name."""
        try:
            result = subprocess.run(
                ["squeue", "--me", "--name", self.SLURM_JOB_NAME,
                 "--noheader", "--states", "R,PD"],
                capture_output=True, text=True, timeout=15
            )
            return len(result.stdout.strip().splitlines()) if result.stdout.strip() else 0
        except (subprocess.TimeoutExpired, FileNotFoundError) as e:
            print(f"  Warning: squeue check failed ({e}), assuming 0 running")
            return 0

    def wait_for_slot(self):
        """Block until Slurm has fewer than max_jobs running/pending."""
        while True:
            running = self._count_running()
            if running < self.max_jobs:
                return
            print(f"  ... {running}/{self.max_jobs} Slurm slots occupied, "
                  f"waiting {self.poll_interval}s...")
            time.sleep(self.poll_interval)

    def wait_for_all(self):
        """Block until all our Slurm jobs have finished."""
        while True:
            running = self._count_running()
            if running == 0:
                return
            print(f"  ... {running} Slurm jobs still active, "
                  f"waiting {self.poll_interval}s...")
            time.sleep(self.poll_interval)

    def launch(self, protein_name: str, p_dir: Path, script_name: str):
        """Submit a single protein run via sbatch with nice priority and job name."""
        self.wait_for_slot()

        cmd = ["sbatch", f"--nice={self.nice}",
               f"--job-name={self.SLURM_JOB_NAME}", script_name]
        result = subprocess.run(cmd, cwd=str(p_dir), capture_output=True, text=True)

        if result.returncode == 0:
            job_id = result.stdout.strip().split()[-1] if result.stdout.strip() else "?"
            self.submitted.append(protein_name)
            print(f"  -> Submitted {protein_name} (Slurm job {job_id}, "
                  f"nice {self.nice}, {len(self.submitted)} total)")
        else:
            print(f"  !! sbatch failed for {protein_name}: {result.stderr.strip()}")

    def summary(self):
        """Print submission summary."""
        print(f"\n{'=' * 45}")
        print(f"Slurm Summary: {len(self.submitted)} jobs submitted")
        print(f"  Nice priority : {self.nice}")
        print(f"  Max concurrent: {self.max_jobs}")
        print(f"  Job name      : {self.SLURM_JOB_NAME}")
        print(f"  Check status  : squeue --me --name {self.SLURM_JOB_NAME}")
        print(f"{'=' * 45}")


def get_protein_status(protein_name: str) -> Tuple[str, str]:
    """Determines status based on file presence in the protein directory."""
    p_dir = Path(protein_name.upper())
    if not p_dir.exists():
        return "r", "Pending"

    steps = [
        ("step1_out.pdb", "Step1"),
        ("step2_out.pdb", "Step2"),
        ("head3.lst",     "Step3"),
        ("pK.out",        "Step4")
    ]

    last_valid_step = "None"
    for filename, step_label in steps:
        if (p_dir / filename).exists():
            last_valid_step = step_label
        else:
            break

    if last_valid_step == "Step4":
        return "c", "Completed"

    log_file = p_dir / "run.log"
    if log_file.exists():
        if last_valid_step == "None":
            return "e", "Failed @ Step1"
        next_idx = int(last_valid_step[-1]) + 1
        return "r", f"In Step{next_idx}"

    return "r", "Pending"


def update_book():
    """Updates book.txt with a clean status table, timestamp, and legend."""
    book_fp = Path(BOOK)
    if not book_fp.exists():
        return

    lines = book_fp.read_text().splitlines()
    protein_ids = []
    ignore_top = {"PDB", "LAST", "UPDATED:", "STATUS"}

    for line in lines:
        parts = line.split()
        if not parts: continue
        first_word = parts[0].upper().strip(":")

        if first_word == "LEGEND" or (line.startswith("-") and len(protein_ids) > 0):
            break
        if first_word in ignore_top or "LAST UPDATED" in line.upper() or line.startswith("-"):
            continue
        if len(parts[0]) < 2 and first_word in {"C", "R", "E"}:
            continue

        protein_ids.append(parts[0].upper())

    now = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    content = [
        f"Last Updated: {now}",
        f"{'PDB':<12} {'Status':<8} {'Last_Step'}",
        "-" * 38
    ]

    for pid in sorted(set(protein_ids)):
        flag, step = get_protein_status(pid)
        content.append(f"{pid:<12} {flag:<8} {step}")

    content.append("\n" + "-" * 38)
    content.append("Legend:")
    content.append(" r : Ready or Running")
    content.append(" c : Completed (pK.out found)")
    content.append(" e : Error (Check run.log in directory)")

    with open(BOOK, "w") as f:
        f.write("\n".join(content) + "\n")


def modify_script_for_runprm(script_path: str):
    """Injects custom run.prm loading into the shell script steps."""
    if not Path(CUSTOM_PRM).exists():
        return
    load_custom_str = f" -load_runprm {CUSTOM_PRM}"
    lines = Path(script_path).read_text().splitlines()
    new_lines = [line.strip() + load_custom_str + "\n" if fnmatch.fnmatch(line.split()[0] if line.split() else "", "step[1234].py") else line + "\n" for line in lines]
    with open(script_path, "w") as f: f.writelines(new_lines)


def process_protein_file(protein_path: str, script_path: str, pool):
    """Sets up the protein directory and launches the run via the pool."""
    p_path = Path(protein_path)
    p_dir = Path(p_path.stem.upper())
    p_dir.mkdir(exist_ok=True)

    shutil.copy2(p_path, p_dir)
    pdb_fp = p_dir / p_path.name
    prot_fp = p_dir / "prot.pdb"
    if prot_fp.exists(): prot_fp.unlink()
    prot_fp.symlink_to(pdb_fp.name)

    if Path(CUSTOM_PRM).exists():
        target = p_dir / CUSTOM_PRM
        if not target.exists(): target.symlink_to(Path(CUSTOM_PRM).absolute())

    shutil.copy2(script_path, p_dir / Path(script_path).name)

    pool.launch(p_path.stem.upper(), p_dir, Path(script_path).name)


def get_user_files(input_path: str) -> List[Path]:
    return [fp for fp in Path(input_path).glob("*.pdb") if not (fnmatch.fnmatch(fp.name, "step[0123]_out.pdb") or fp.name == "prot.pdb")]


def ask_user(question: str) -> bool:
    while True:
        res = input(f"{question} (y/n): ").lower().strip()
        if res in ['y', 'yes']: return True
        if res in ['n', 'no']: return False
        print(BAD_ANSWER)


def protein_batch():
    parser = argparse.ArgumentParser(prog="pro_batch", description="Batch launch MCCE runs.")
    parser.add_argument("input_path", type=str, help=inputpath_help)
    parser.add_argument("-custom", default="", help="Path to custom bash script.")
    parser.add_argument("-j", "--jobs", type=int, default=DEFAULT_MAX_JOBS,
                        help=f"Max concurrent jobs (default: {DEFAULT_MAX_JOBS}). "
                             "Controls how many MCCE runs execute simultaneously.")
    parser.add_argument("--nice", type=int, default=None,
                        help="Lower priority = nicer to other users. "
                             "Slurm mode (default): range 0-10000, default 1000. "
                             "Bash mode (--no_slurm): range 0-19, default 10. "
                             "Higher values = lower priority.")
    parser.add_argument("--no_slurm", action="store_true", default=False,
                        help="Run jobs directly via bash instead of the Slurm scheduler. "
                             "Jobs are still low priority (nice 10) unless --nice is set.")
    parser.add_argument("--check", action="store_true", help="Update book.txt status and exit.")
    args = parser.parse_args()

    # Path resolution
    if datasets_dict and args.input_path in datasets_dict:
        input_path = str(BenchResources(args.input_path).BENCH_PDBS)
    else:
        input_path = args.input_path
        if not Path(input_path).is_dir():
            print(f"Error: {input_path} is not a directory."); sys.exit(1)

    script_path = args.custom if args.custom else (Path(SUBMIT_SCRIPT) if Path(SUBMIT_SCRIPT).exists() else None)
    if not script_path and not args.check:
        if SUBMIT_SCRIPT_PATH.exists():
            shutil.copy2(SUBMIT_SCRIPT_PATH, Path(SUBMIT_SCRIPT))
            Path(SUBMIT_SCRIPT).chmod(0o755)
            print(f"Created default {SUBMIT_SCRIPT}. Edit it then re-run."); sys.exit(0)
        else:
            print("Error: Submission script not found."); sys.exit(1)

    user_files = get_user_files(input_path)
    if not user_files:
        print("No valid PDB files found."); sys.exit(1)

    if not Path(BOOK).exists():
        with open(BOOK, 'w') as f:
            for fp in sorted(user_files): f.write(f"{fp.stem.upper():<12} r\n")

    update_book()
    if args.check:
        print(f"Book status refreshed in {BOOK}."); return

    # --- CATEGORIZED RE-RUN LOGIC ---
    lines = Path(BOOK).read_text().splitlines()
    error_prots = []
    other_prots = []
    new_prots = []

    for line in lines:
        parts = line.split()
        if len(parts) >= 2 and len(parts[0]) >= 3 and not parts[0].startswith("-") and parts[0].upper() not in ["PDB", "LAST"]:
            pdb_name = parts[0].upper()
            status = parts[1]

            if not Path(pdb_name).is_dir():
                new_prots.append(pdb_name)
            elif status == 'e':
                error_prots.append(pdb_name)
            else:
                other_prots.append(pdb_name)

    final_targets = []

    if new_prots:
        print(f"\nFound {len(new_prots)} new or missing runs: {', '.join(new_prots)}")
        final_targets.extend(new_prots)

    if error_prots:
        print(f"\nFound {len(error_prots)} existing runs with errors ('e'): {', '.join(error_prots)}")
        if ask_user("Would you like to re-run these error cases?"):
            final_targets.extend(error_prots)

    if other_prots:
        print(f"\nFound {len(other_prots)} existing runs (Completed 'c' or Running 'r').")
        if ask_user("Would you like to re-run/overwrite these as well?"):
            final_targets.extend(other_prots)

    if not final_targets:
        print("\nNo proteins selected for processing. Exiting."); return

    modify_script_for_runprm(str(script_path))

    # --- LAUNCH WITH JOB POOL ---
    if args.no_slurm:
        nice = args.nice if args.nice is not None else DEFAULT_NICE
        pool = JobPool(max_jobs=args.jobs, nice=nice)
        mode_str = f"bash (max {args.jobs} concurrent, nice {nice})"
    else:
        nice = args.nice if args.nice is not None else DEFAULT_SLURM_NICE
        pool = SlurmPool(max_jobs=args.jobs, nice=nice)
        mode_str = f"Slurm (max {args.jobs} concurrent, nice {nice})"

    print(f"\nLaunching {len(final_targets)} runs via {mode_str}...")

    for fp in user_files:
        if fp.stem.upper() in final_targets:
            process_protein_file(fp, str(script_path), pool)

    print("\nAll jobs submitted. Waiting for remaining jobs to finish...")
    pool.wait_for_all()

    update_book()
    pool.summary()
    print(f"Monitor status in {BOOK}.")


if __name__ == "__main__":
    protein_batch()
