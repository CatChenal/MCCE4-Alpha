#!/usr/bin/env python
import os
import sys

def check_files_in_directories():
    current_dir = os.getcwd()
    subdirectories = sorted([d for d in os.listdir(current_dir) if os.path.isdir(d)])

    target_files = ["step1_out.pdb", "step2_out.pdb", "head3.lst", "pK.out"]
    step_names = ["step1", "step2", "step3", "step4"]
    step_weights = {"step1_out.pdb": 0.5, "step2_out.pdb": 0.5, "head3.lst": 7, "pK.out": 2}

    results = []
    all_pk_out_exists = True
    missing_step1_dirs = []
    completed_count = 0
    completed_files = set()
    total_completion = 0
    inconsistent_steps_dirs = set()
    found_mcce_dirs = False

    for subdir in subdirectories:
        subdir_path = os.path.join(current_dir, subdir)

        if not os.path.isfile(os.path.join(subdir_path, "prot.pdb")):
            continue

        files_status = {file: os.path.isfile(os.path.join(subdir_path, file)) for file in target_files}
        file_times = {file: os.path.getmtime(os.path.join(subdir_path, file)) if files_status[file] else None for file in target_files}

        # Detect outdated steps (higher step older than previous step)
        outdated_flags = [False] * len(target_files)
        for i in range(1, len(target_files)):
            if file_times[target_files[i]] and file_times[target_files[i - 1]]:
                if file_times[target_files[i]] < file_times[target_files[i - 1]]:
                    outdated_flags[i] = True
                    inconsistent_steps_dirs.add(subdir)

        protein_completion = sum(step_weights[file] for file in target_files if files_status[file])
        total_completion += protein_completion

        step4_completed = all(files_status[file] for file in target_files)
        if step4_completed:
            completed_count += 1
            completed_files.add(subdir)

        row = [subdir]
        for i, file in enumerate(target_files):
            if files_status[file]:
                entry = "Exists*" if outdated_flags[i] else "Exists"
                found_mcce_dirs = True
            else:
                entry = "      "
            row.append(entry)
        row.append("Done" if step4_completed else "")
        results.append(row)

        if not files_status.get("step1_out.pdb"):
            missing_step1_dirs.append(subdir)

        # Check for 'f' errors in head3.lst
        if files_status.get("head3.lst"):
            head3_path = os.path.join(subdir_path, "head3.lst")
            conf_error_lines = []

            try:
                with open(head3_path, 'r') as head3_file:
                    for line in head3_file:
                        columns = line.split()
                        if columns and columns[-1] == 'f':
                            conf_error_lines.append(line.strip())

                if conf_error_lines:
                    error_file_path = os.path.join(subdir_path, "conf_errors.txt")
                    with open(error_file_path, 'w') as error_file:
                        error_file.write("\n".join(conf_error_lines))

            except Exception as e:
                print(f"Error reading head3.lst in {subdir}: {e}")
                return

        if not files_status.get("pK.out"):
            all_pk_out_exists = False

    total_dirs = len(results)
    max_completion = total_dirs * sum(step_weights.values()) if total_dirs > 0 else 1
    completion_percentage = (total_completion / max_completion) * 100

    if not found_mcce_dirs:
        print("mcce_stat looks in the PWD for MCCE directories containing PDB files sybolically linked to 'prot.pdb', and it can't find any. Aborting...")
        sys.exit(1)

    print("To see when PDB was run, reference mcce_timing.log in running directory. (pro_batch)\n")
    print(f"Completion: {completion_percentage:.2f}%")

    if results:
        col_widths = [max(len(str(row[i])) for row in ([["Directory"] + target_files + ["Status"]] + results)) for i in range(len(results[0]))]
    else:
        col_widths = [len(col) for col in ["Directory"] + target_files + ["Status"]]

    header = ["Directory"] + step_names + ["Status"]
    print(" ".join(header[i].ljust(col_widths[i]) for i in range(len(header))))
    for row in results:
        print(" ".join(str(row[i]).ljust(col_widths[i]) for i in range(len(row))))

    if missing_step1_dirs:
        print("These directories failed to start correctly: " + ", ".join(sorted(missing_step1_dirs)))

    if inconsistent_steps_dirs:
        print("\nWARNING: steps marked with an asterisk have timestamps older than a prior step.")

    if all_pk_out_exists and total_dirs == len(subdirectories):
        print("All runs completed as expected.")

if __name__ == "__main__":
    if len(sys.argv) > 1:
        if sys.argv[1] == "-h":
            print("mcce_stat keeps track of progressing and completed MCCE runs. After using p_batch, or bench_batch, mcce_stat looks for relevant files in subdirectories representing protein runs- for example, 'step1_out' in a protein directory means step 1 of MCCE is finished for that protein.\n")
            print("mcce_stat looks for directories containing files named 'prot.pdb'- the name MCCE uses to symbolically link PDB files.\n")
            print("Use 'mcce_stat' in a directory with one or more protein run directories.")
            sys.exit(1)
        print("mcce_stat doesn't take arguments, unless you meant to use flag '-h'. Aborting mcce_stat.")
        sys.exit(1)
    check_files_in_directories()

