# .condarc — project-level conda configuration for MCCE4-Alpha
#
# Conda reads this file automatically when run from (or below) this directory.
# It does NOT affect the user's global conda config (~/.condarc).
#
# Key effects:
#   - solver: libmamba   → uses the fast C++ solver (10-50x faster than classic)
#   - channel_priority   → strict: only use packages from the first channel that
#                          has them, avoids slow cross-channel conflict resolution
#   - channels           → conda-forge first, then defaults as fallback

solver: libmamba

channel_priority: strict

channels:
  - conda-forge
  - defaults
