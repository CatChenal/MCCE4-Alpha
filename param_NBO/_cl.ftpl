# Conformer definition
CONFLIST, _CL: _CLBK, _CL-1, _CLDM

# Atom definition
CONNECT, "CL  ", _CL-1: ion, 

# Atom charges
CHARGE, _CL-1, "CL  ": -1.000

# Atom radius, dielelctric boundary radius, VDW radius, and energy well depth
RADIUS,  _CL-1,  "CL  ": 1.937,   2.000,   0.173

# Conformer parameters that appear in head3.lst: ne, Em0, nH, pKa0, rxn
#CONFORMER, _CL-1: Em0=  0.0, pKa0=  0.00, ne= 0, nH= 0, rxn02=-40.6, rxn04=-20.323, rxn08=-10.1
CONFORMER, _CL-1: Em0=  0.0, pKa0=  0.00, ne= 0, nH= 0, rxn02= -41.717, rxn04= -20.324, rxn08= -9.627
CONFORMER, _CLDM: Em0=  0.0, pKa0=  0.00, ne= 0, nH= 0, rxn02=0.0, rxn08=0.0, rxn04=0.0

# Rotatable bonds. The atoms extended in the bond direction will all be rotated.
