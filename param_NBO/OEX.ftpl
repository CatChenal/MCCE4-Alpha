>>>START of original comments, this file was converted from old format
# 1. Basic Conformer Information: name, pka, em, rxn
# 2. Structure Connectivity:
#    - RCSB OEX.cif --> OEC.pdb 
# 3. Atom Parameters: Partial Charges and Radii
#    - Hard Charges were used from the S1 State Configuration 
# File Created by Gehan Ranepura on 02/14/2026
<<<END of original comments

# Conformer definition
CONFLIST, OEX: OEXBK, OEX01

# ATOM name and bonds
CONNECT, " O1 ", OEX01:  sp3, "CA1 ","MN1 ","MN2 "
CONNECT, "CA1 ", OEX01:  sp3, " O1 "," O2 "," O5 "
CONNECT, "MN1 ", OEX01:  sp3, " O1 "," O5 "," O3 "
CONNECT, " O2 ", OEX01:  sp3, "CA1 ","MN2 ","MN3 "
CONNECT, "MN2 ", OEX01:  sp3, " O1 "," O2 "," O3 "
CONNECT, " O3 ", OEX01:  sp3, "MN1 ","MN2 ","MN3 "
CONNECT, "MN3 ", OEX01:  sp3, " O2 "," O3 "," O4 "," O5 "
CONNECT, " O4 ", OEX01:  sp3, "MN3 ","MN4 "
CONNECT, "MN4 ", OEX01:  sp3, " O5 "," O4 "
CONNECT, " O5 ", OEX01:  sp3, "CA1 ","MN1 ","MN4 ","MN3 "


# ATOM charges
CHARGE, OEX01, " O1 ": -2.000
CHARGE, OEX01, "CA1 ":  2.000
CHARGE, OEX01, "MN1 ":  3.000
CHARGE, OEX01, " O2 ": -2.000
CHARGE, OEX01, "MN2 ":  4.000
CHARGE, OEX01, " O3 ": -2.000
CHARGE, OEX01, "MN3 ":  4.000
CHARGE, OEX01, " O4 ": -2.000
CHARGE, OEX01, "MN4 ":  3.000
CHARGE, OEX01, " O5 ": -2.000


# Atom radius, dielectric boundary radius, VDW radius, and energy well depth
RADIUS, OEX01, " O1 ":  1.400,  1.600,  0.200
RADIUS, OEX01, "CA1 ":  1.850,  2.000,  0.173
RADIUS, OEX01, "MN1 ":  1.850,  2.000,  0.173
RADIUS, OEX01, " O2 ":  1.400,  1.600,  0.200
RADIUS, OEX01, "MN2 ":  1.850,  2.000,  0.173
RADIUS, OEX01, " O3 ":  1.400,  1.600,  0.200
RADIUS, OEX01, "MN3 ":  1.850,  2.000,  0.173
RADIUS, OEX01, " O4 ":  1.400,  1.600,  0.200
RADIUS, OEX01, "MN4 ":  1.850,  2.000,  0.173
RADIUS, OEX01, " O5 ":  1.400,  1.600,  0.200


# Conformer parameters that appear in head3.lst: ne, Em0, nH, pKa0, rxn
CONFORMER, OEX01:  Em0=0.0, pKa0=0.00, ne=0, nH=0, rxn02= -1062.291, rxn04= -515.859, rxn08= -242.909  # Calibrated using NGPB 
