# Conformer definition
CONFLIST, OEC: OECBK, OEC01

# ATOM name and bonds
CONNECT, " MN1", OEC01: sp3, " O1 ", " O3 ", " O4 ", " O5 "  
CONNECT, " MN2", OEC01: sp3, " O1 ", " O2 ", " O4 "
CONNECT, " MN3", OEC01: sp3, " O2 ", " O3 ", " O4 "
CONNECT, " MN4", OEC01: sp3, " O4 ", " O5 "
CONNECT, " CA1", OEC01: sp3, " O1 ", " O2 ", " O3 ", " O5 "
CONNECT, " O1 ", OEC01: sp3, " MN1", " MN2", " CA1"
CONNECT, " O2 ", OEC01: sp3, " MN2", " MN3", " CA1"
CONNECT, " O3 ", OEC01: sp3, " MN1", " MN3", " CA1"
CONNECT, " O4 ", OEC01: sp3, " MN1", " MN2", " MN3", " MN4"
CONNECT, " O5 ", OEC01: sp3, " MN1", " MN4", " CA1"


# ATOM charges
CHARGE, OEC01, " MN1":  4.00
CHARGE, OEC01, " MN2":  4.00
CHARGE, OEC01, " MN3":  3.00
CHARGE, OEC01, " MN4":  3.00
CHARGE, OEC01, " CA1":  2.00
