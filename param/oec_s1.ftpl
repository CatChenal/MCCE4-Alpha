RADIUS, OEC01, " MN1":  1.850,  2.000,  0.173
RADIUS, OEC01, " MN2":  1.850,  2.000,  0.173
RADIUS, OEC01, " MN3":  1.850,  2.000,  0.173
RADIUS, OEC01, " MN4":  1.850,  2.000,  0.173
RADIUS, OEC01, " CA1":  1.700,  2.000,  0.150
