CONNECT, " C13", CP301: sp3, " C12", " C14", " C15", "H13 "
CONNECT, " C14", CP301: sp3, " C13", "H141", "H142", "H143"
CONNECT, " C15", CP301: sp3, " C13", " ?  ", "H151", "H152"
CONNECT, " C12", CP301: sp3, " C11", " C13", "H121", "H122"
CONNECT, "H111", CP301: s, " C11"
CONNECT, "H112", CP301: s, " C11"
CONNECT, "H121", CP301: s, " C12"
CONNECT, "H122", CP301: s, " C12"
CONNECT, "H13 ", CP301: s, " C13"
CONNECT, "H141", CP301: s, " C14"
CONNECT, "H142", CP301: s, " C14"
CONNECT, "H143", CP301: s, " C14"
CONNECT, "H151", CP301: s, " C15"
CONNECT, "H152", CP301: s, " C15"


