# Conformer definition
CONFLIST,  _MG:  _MGBK, _MG+2, _MGDM

# ATOM name and bonds
CONNECT, "MG  ", _MG+2: ion 

# ATOM charges
CHARGE, _MG+2, "MG  ": 2.00

# Atom radius, dielectric boundary radius, VDW radius, and energy well depth
RADIUS, _MG+2, "MG  ":  1.850,  2.000,  0.173

# Conformer parameters that appear in head3.lst: ne, Em0, nH, pKa0, rxn
#CONFORMER, _MG+2:  Em0=  0.0, pKa0=  0.00, ne=0, nH=0, rxn02= 0, rxn04= 0, rxn08= 0
CONFORMER, _MG+2:  Em0=  0.0, pKa0=  0.00, ne=0, nH=0, rxn02= -174.987, rxn04= -85.250, rxn08= -40.382
CONFORMER, _MGDM:  Em0=  0.0, pKa0=  0.00, ne=0, nH=0, rxn02= 0, rxn04= 0, rxn08= 0

# Rotatable bonds. The atoms extended in the bond direction will all be rotated.
