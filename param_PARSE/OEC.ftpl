>>>START of original comments, this file was converted from old format
# 1. Basic Conformer Information: name, pka, em, rxn
# 2. Structure Connectivity:
#    - RCSB OEC.cif --> OEC.pdb
# 3. Atom Parameters: Partial Charges and Radii
#    - Hard Charges were used from the S1 State Configuration
# File Created by Gehan Ranepura on 02/14/2026
<<<END of original comments

# Conformer definition
CONFLIST, OEC: OECBK, OEC01

# ATOM name and bonds
CONNECT, "MN1 ", OEC01:  sp3, " O1 "," O2 "," O3 "
CONNECT, "MN2 ", OEC01:  sp3, " O1 "," O2 "," O4 "
CONNECT, "MN3 ", OEC01:  sp3, " O2 "," O3 "," O4 "
CONNECT, "MN4 ", OEC01:  sp3, " O4 "
CONNECT, " O1 ", OEC01:  sp3, "MN1 ","MN2 ","CA1 "
CONNECT, " O2 ", OEC01:  sp3, "MN1 ","MN2 ","MN3 "
CONNECT, " O3 ", OEC01:  sp3, "MN1 ","MN3 ","CA1 "
CONNECT, " O4 ", OEC01:  sp3, "MN2 ","MN3 ","MN4 ","CA1 "
CONNECT, "CA1 ", OEC01:  sp3, " O1 "," O3 "," O4 "


# ATOM charges
CHARGE, OEC01, "MN1 ":  3.000
CHARGE, OEC01, "MN2 ":  4.000 
CHARGE, OEC01, "MN3 ":  4.000 
CHARGE, OEC01, "MN4 ":  3.000
CHARGE, OEC01, " O1 ": -2.000
CHARGE, OEC01, " O2 ": -2.000
CHARGE, OEC01, " O3 ": -2.000
CHARGE, OEC01, " O4 ": -2.000
CHARGE, OEC01, "CA1 ":  2.000


# Atom radius, dielectric boundary radius, VDW radius, and energy well depth
RADIUS, OEC01, "MN1 ":  1.850,  2.000,  0.173
RADIUS, OEC01, "MN2 ":  1.850,  2.000,  0.173
RADIUS, OEC01, "MN3 ":  1.850,  2.000,  0.173
RADIUS, OEC01, "MN4 ":  1.850,  2.000,  0.173
RADIUS, OEC01, " O1 ":  1.400,  1.600,  0.200
RADIUS, OEC01, " O2 ":  1.400,  1.600,  0.200
RADIUS, OEC01, " O3 ":  1.400,  1.600,  0.200
RADIUS, OEC01, " O4 ":  1.400,  1.600,  0.200
RADIUS, OEC01, "CA1 ":  1.850,  2.000,  0.173


# Conformer parameters that appear in head3.lst: ne, Em0, nH, pKa0, rxn
CONFORMER, OEC01:  Em0=0.0, pKa0=0.00, ne=0, nH=0, rxn02= -1711.856, rxn04= -832.654, rxn08= -393.267  # Calibrated using NGPB
