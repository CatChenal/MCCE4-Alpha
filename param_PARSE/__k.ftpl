#3.Atom Parameters: Partial Charges and Radii
# Radii(vdw) were collected from http://www.webelements.com/
# Values of the same key are appended and separated by ","
<<<END of original comments

# Conformer definition
CONFLIST, __K: __KBK, __K+1, __KDM

# Atom definition
CONNECT, " K  ", __K+1: ion, 

# Atom charges
CHARGE, __K+1, " K  ": 1.000

# Atom radius, dielelctric boundary radius, VDW radius, and energy well depth
RADIUS,  __K+1,  " K  ": 1.937,   2.000,   0.173

# Conformer parameters that appear in head3.lst: ne, Em0, nH, pKa0, rxn
#CONFORMER, __K+1: Em0=   0.0, pKa0=  0.00, ne= 0, nH= 0, rxn02=0, rxn04=0, rxn08=0  
CONFORMER, __K+1: Em0=   0.0, pKa0=  0.00, ne= 0, nH= 0, rxn02= -41.717, rxn04= -20.324, rxn08= -9.627   # Added by Gehan using NGPB 01/22/2026
CONFORMER, __KDM: Em0=   0.0, pKa0=  0.00, ne= 0, nH= 0, rxn02=0.0, rxn08=0.0, rxn04=0.0

# Rotatable bonds. The atoms extended in the bond direction will all be rotated.
